# Local development on your own laptop: copy to backend/.env
# Any username and password will sign you in. Never use these settings on a server.
FNB_ENV=development
FNB_AUTH_MODE=dev
FNB_COOKIE_SECURE=false
FNB_SESSION_SECRET=local-development-only-not-a-secret
FNB_DATABASE_URL=sqlite:///./dev-app.db

# Sign in with this username to be admin; any other username starts as officer.
FNB_BOOTSTRAP_ADMINS=admin

# python -m app.dev_seed creates a sample bank database and adds it on the Data sources page.
FNB_GRAPH_MAILBOX=customercare@fnb.example
FNB_INTERNAL_EMAIL_DOMAINS=fnb.example
FNB_APP_BASE_URL=http://localhost:5173

# ---- Phase switch ---------------------------------------------------------------------
# Phase 1 (false): topics give the same answer to everyone (fees, hours, how-tos), from one
# database. Phase 2 (true): topics may also answer from a customer's own records (balances,
# transactions), only for senders verified by Microsoft 365. Turn on after IT/security sign-off.
FNB_CUSTOMER_DATA_ANSWERS=false

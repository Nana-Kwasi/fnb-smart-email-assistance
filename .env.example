# Copy to .env and fill in. Never commit .env.

# ---- General ----------------------------------------------------------------
FNB_ENV=production
FNB_TIMEZONE=UTC                       # e.g. Africa/Johannesburg; used for "today" on the dashboard
POSTGRES_PASSWORD=change-me            # docker-compose only
# FNB_DATABASE_URL is set by docker-compose. Without Docker:
# FNB_DATABASE_URL=postgresql+psycopg://fnb_care:PASSWORD@localhost:5432/fnb_care

# ---- Sessions ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FNB_SESSION_SECRET=
FNB_COOKIE_SECURE=true                 # false only for local development over http
FNB_SESSION_MAX_HOURS=8

# ---- Active Directory (LDAPS) -------------------------------------------------
FNB_LDAP_URL=ldaps://ad.fnb.local:636
FNB_LDAP_CA_CERT_FILE=/certs/ad-ca.pem     # the CA that signed the AD certificate
FNB_LDAP_BIND_DN=CN=svc-email-care,OU=Service Accounts,DC=fnb,DC=local
FNB_LDAP_BIND_PASSWORD=
FNB_LDAP_USER_SEARCH_BASE=OU=Staff,DC=fnb,DC=local
FNB_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# Only members of this AD group can sign in. Roles are managed on the dashboard's Users screen.
FNB_LDAP_GROUP=CN=EmailCare-Users,OU=Groups,DC=fnb,DC=local
# Usernames that become admin on their first sign-in (everyone else starts as officer).
FNB_BOOTSTRAP_ADMINS=your.username

# ---- Microsoft 365 / Outlook (Microsoft Graph) -------------------------------
FNB_GRAPH_TENANT_ID=
FNB_GRAPH_CLIENT_ID=
FNB_GRAPH_CLIENT_SECRET=
FNB_GRAPH_MAILBOX=customercare@fnb.example
FNB_POLL_INTERVAL_SECONDS=30

# ---- Alerts to the people in charge -----------------------------------------------
# Alerts and daily summaries can only go to addresses in these domains (comma-separated).
FNB_INTERNAL_EMAIL_DOMAINS=fnb.example
# The dashboard's address, used for links in alert emails.
FNB_APP_BASE_URL=https://emailcare.fnb.example

# ---- The bank's databases --------------------------------------------------------
# Admins add them on the dashboard's Data sources page. Their passwords are encrypted with this
# key. Generate once and keep it safe (losing it means re-entering the database passwords):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FNB_ENCRYPTION_KEY=
FNB_QUERY_TIMEOUT_SECONDS=15
FNB_QUERY_MAX_ROWS=50

# ---- Phase switch ---------------------------------------------------------------------
# Phase 1 (false): topics give the same answer to everyone (fees, hours, how-tos), from one
# database. Phase 2 (true): topics may also answer from a customer's own records (balances,
# transactions), only for senders verified by Microsoft 365. Turn on after IT/security sign-off.
FNB_CUSTOMER_DATA_ANSWERS=false

# ---- Self-hosted AI model (Qwen3.5) ----------------------------------------------------
# Off by default: the assistant then works exactly as before (rules + approved text only).
# Any OpenAI-compatible server works: vLLM (production), Ollama or llama.cpp (pilot/laptop).
# The server must be on the bank's network; see docs/ai-model-setup.md.
FNB_LLM_ENABLED=false
FNB_LLM_BASE_URL=http://llm:8000/v1             # vLLM; Ollama: http://<host>:11434/v1
FNB_LLM_API_KEY=                                # only if the model server requires one
FNB_LLM_FAST_MODEL=                             # classification, e.g. the served name of a small Qwen3.5
FNB_LLM_STRONG_MODEL=                           # drafting; leave empty to use the fast model
FNB_LLM_TIMEOUT_SECONDS=60
FNB_LLM_MAX_RETRIES=1
FNB_LLM_MAX_CONCURRENCY=2
# Server-specific JSON merged into each request. Qwen3.5 on vLLM, to skip "thinking" output:
# FNB_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
FNB_LLM_EXTRA_BODY=
# Customer emails are sent to the model. Leave false unless the bank has approved, in
# writing, a model provider outside its own network.
FNB_LLM_ALLOW_EXTERNAL=false

# ---- Attachment scanning (ClamAV) ------------------------------------------------------
# Without a scanner, attachments are listed for staff but never opened by the assistant.
FNB_CLAMD_HOST=                                 # e.g. clamav (docker compose --profile scanning)
FNB_CLAMD_PORT=3310
FNB_ATTACHMENT_MAX_MB=10

# Apply database migrations automatically when the API starts (default true).
FNB_AUTO_MIGRATE=true
